{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "generic-app values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespace": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "istioInjection": { "type": "string", "enum": ["", "enabled", "disabled"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podLabels": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "command": { "type": "array" },
    "args": { "type": "array" },
    "env": { "type": "array" },
    "envFrom": { "type": "array" },
    "probes": {
      "type": "object",
      "properties": {
        "liveness": { "type": "object" },
        "readiness": { "type": "object" },
        "startup": { "type": "object" }
      }
    },
    "resources": { "type": "object" },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "volumes": { "type": "array" },
    "volumeMounts": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["port", "targetPort"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer" },
        "targetPort": { "type": ["integer", "string"] },
        "annotations": { "type": "object" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "gateway": {
          "type": "object",
          "required": ["name", "namespace"],
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" },
            "sectionName": { "type": "string" }
          }
        },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "backendRef": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "port": { "type": ["integer", "string"] }
          }
        },
        "rules": { "type": "array" }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretStoreRef": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string", "enum": ["ClusterSecretStore", "SecretStore"] }
          }
        },
        "secretName": { "type": "string" },
        "refreshInterval": { "type": "string" },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["secretKey", "remoteRef"],
            "properties": {
              "secretKey": { "type": "string" },
              "remoteRef": {
                "type": "object",
                "required": ["key"],
                "properties": {
                  "key": { "type": "string" },
                  "property": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
